# ============================================================
# MARVELOUS HOTEL — Git Ignore Rules
# ============================================================

# Environment & Sensitive Config
.env
.env.*
!.env.example
LIVE_URL.txt
storage/.cred_vault.key
storage/*.key

# Cache & Temporary Files
.phpunit.result.cache
*.cache
*.tmp
*.zip
.DS_Store
Thumbs.db

# Generated Documentation PDFs
docs/*.pdf

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Log Files, Sessions & Runtime Cache (keep .gitkeep)
logs/*.log
storage/logs/*.log
storage/sessions/*
storage/cache/*
!logs/.gitkeep
!storage/logs/.gitkeep
!storage/sessions/.gitkeep
!storage/cache/.gitkeep

# User Uploads (keep directory structure and default images)
uploads/avatars/*
uploads/proofs/*
uploads/ids/*
uploads/documents/*
!uploads/avatars/default-avatar.png
!uploads/avatars/.gitkeep
!uploads/proofs/.gitkeep
!uploads/ids/.gitkeep
!uploads/documents/.gitkeep

# Composer & Vendor
/vendor/
frontend/node_modules/

