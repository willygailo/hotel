{
  "name": "marvelous-hotel-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Marvelous Hotel Tier 1 Frontend — Tailwind CSS + Alpine.js 3 + HotelAPI REST Client",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./src/tailwind-input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./src/tailwind-input.css -o ./assets/css/tailwind.css --watch",
    "sync:alpine": "cp ./node_modules/alpinejs/dist/cdn.min.js ./assets/vendor/alpine.min.js",
    "build": "npm run build:css && npm run sync:alpine"
  },
  "dependencies": {
    "alpinejs": "^3.14.9"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
